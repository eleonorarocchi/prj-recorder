{
  "name": "prj-recorder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "node build/index.js",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@auth/sveltekit": "1.11.3",
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "sanitize-html": "2.18.0",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@types/node": "24.10.1",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "svelte-check": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
