NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/recorder.sqlite
PERSISTENT_DISK_MOUNT_PATH=/var/data
# Auth.js: generate a random secret of at least 32 characters. Keep secrets in .env.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_TRUST_HOST=true
# Numeric GitHub account ID allowed to use the archive.
GITHUB_ALLOWED_USER_ID=
